FROM golang:1.22-bookworm AS heybuild
RUN go install github.com/rakyll/hey@v0.1.4

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=heybuild /go/bin/hey /usr/local/bin/hey

WORKDIR /perf
COPY uploadkit-testing/perf/scripts /perf/scripts
RUN chmod +x /perf/scripts/*.sh

ENV API_BASE=http://api:8000
ENV ARTIFACTS_DIR=/artifacts

CMD ["./scripts/smoke_curl.sh"]
